{
  "name": "clawspace",
  "type": "module",
  "version": "2.2.0",
  "description": "Clawspace - browser file explorer/editor for OpenClaw workspaces",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "vp run format:check && astro check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "format": "vp fmt . && vp lint --fix .",
    "format:check": "vp fmt --check . && vp lint --max-warnings 0 .",
    "lint": "vp lint .",
    "lint:fix": "vp lint --fix .",
    "prepare": "vp config"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/mdx": "^5.0.3",
    "@astrojs/netlify": "^7.0.10",
    "@astrojs/node": "^10.1.3",
    "@astrojs/react": "^5.0.5",
    "@astrojs/rss": "^4.0.18",
    "@astrojs/sitemap": "^3.7.2",
    "@expressive-code/plugin-line-numbers": "^0.42.0",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/space-grotesk": "^5.2.10",
    "@github/relative-time-element": "^5.0.0",
    "@tanstack/react-query": "^5.101.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@varlock/astro-integration": "^0.2.7",
    "astro": "^6.4.2",
    "astro-expressive-code": "^0.42.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "geist": "^1.7.0",
    "lite-youtube-embed": "^0.3.4",
    "lucide-react": "^1.14.0",
    "luxon": "^3.7.2",
    "marked": "^18.0.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "remark-directive": "^4.0.0",
    "rss-parser": "^3.13.0",
    "tailwind-merge": "^3.6.0",
    "typescript": "^6.0.3",
    "unist-util-visit": "^5.1.0",
    "varlock": "^1.5.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.4",
    "@types/js-yaml": "^4.0.9",
    "@types/jsdom": "^27.0.0",
    "@types/luxon": "^3.7.1",
    "@types/node": "^25.0.3",
    "dotenv": "^17.4.2",
    "esbuild": "^0.28.0",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "globals": "^17.6.0",
    "js-yaml": "^4.1.1",
    "jsdom": "^29.1.1",
    "slugify": "^1.6.9",
    "tailwindcss": "^4.3.0",
    "typescript-eslint": "^8.60.1",
    "vite-plus": "latest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nickytonline/clawspace.git"
  },
  "keywords": [
    "astro",
    "workspace",
    "file-browser",
    "code-editor"
  ],
  "author": "Nick Taylor",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/nickytonline/clawspace/issues"
  },
  "homepage": "https://github.com/nickytonline/clawspace#readme",
  "packageManager": "npm@11.12.1",
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@latest",
    "vitest": "npm:@voidzero-dev/vite-plus-test@latest"
  }
}
