---
import WorkspaceLayout from "../layouts/WorkspaceLayout.astro";

const showInternalFiles =
  Astro.cookies.get("clawspace_show_internal_files")?.value === "true";
const defaultHomeView =
  Astro.cookies.get("clawspace_default_home_view")?.value === "timeline"
    ? "timeline"
    : "files";
---

<WorkspaceLayout
  title="⚙️ Settings"
  metaDesc="Clawspace settings"
  breadcrumbs={[
    { label: "Workspace", href: "/workspace" },
    { label: "Settings", href: "/settings" },
  ]}
>
  <section class="space-y-6">
    <h1 class="text-2xl font-bold">Settings</h1>

    <div class="rounded-lg border border-gray-200 dark:border-gray-700 p-4">
      <ul class="space-y-5">
        <li>
          <label
            for="toggle-internal-files"
            class="flex items-start justify-between gap-4 cursor-pointer"
          >
            <div class="min-w-0">
              <span
                id="setting-show-internal-files-label"
                class="block font-semibold"
              >
                Show internal files
              </span>
              <p
                id="setting-show-internal-files-description"
                class="text-gray-600 dark:text-gray-400"
              >
                Toggle visibility of root internal files like SOUL.md,
                MEMORY.md, and .env.
              </p>
            </div>
            <input
              id="toggle-internal-files"
              type="checkbox"
              class="mt-1 h-5 w-5 shrink-0 accent-red-600"
              aria-labelledby="setting-show-internal-files-label"
              aria-describedby="setting-show-internal-files-description"
              checked={showInternalFiles}
            />
          </label>
        </li>

        <li class="space-y-2">
          <div class="min-w-0">
            <span id="setting-default-view-label" class="block font-semibold">
              Default home view
            </span>
            <p
              id="setting-default-view-description"
              class="text-gray-600 dark:text-gray-400"
            >
              Choose whether the home page opens in Files or Timeline view.
            </p>
          </div>

          <div
            class="flex gap-4"
            role="radiogroup"
            aria-labelledby="setting-default-view-label"
            aria-describedby="setting-default-view-description"
          >
            <label
              for="default-view-files"
              class="inline-flex items-center gap-2 cursor-pointer"
            >
              <input
                id="default-view-files"
                type="radio"
                name="default-home-view"
                value="files"
                class="h-4 w-4 accent-red-600"
                checked={defaultHomeView === "files"}
              />
              <span>Files</span>
            </label>
            <label
              for="default-view-timeline"
              class="inline-flex items-center gap-2 cursor-pointer"
            >
              <input
                id="default-view-timeline"
                type="radio"
                name="default-home-view"
                value="timeline"
                class="h-4 w-4 accent-red-600"
                checked={defaultHomeView === "timeline"}
              />
              <span>Timeline</span>
            </label>
          </div>
        </li>
      </ul>
    </div>
  </section>
</WorkspaceLayout>

<script is:inline>
  function setCookie(name, value, days = 365) {
    const expires = new Date(Date.now() + days * 24 * 60 * 60 * 1000);
    document.cookie = `${name}=${value}; expires=${expires.toUTCString()}; path=/; SameSite=Lax`;
  }

  function bindSettings() {
    const input = document.getElementById("toggle-internal-files");
    if (input instanceof HTMLInputElement && input.dataset.bound !== "true") {
      input.dataset.bound = "true";

      input.addEventListener("change", () => {
        setCookie(
          "clawspace_show_internal_files",
          input.checked ? "true" : "false"
        );
      });
    }

    document
      .querySelectorAll('input[name="default-home-view"]')
      .forEach((radio) => {
        if (!(radio instanceof HTMLInputElement)) return;
        if (radio.dataset.bound === "true") return;

        radio.dataset.bound = "true";
        radio.addEventListener("change", () => {
          if (!radio.checked) return;
          setCookie("clawspace_default_home_view", radio.value);
        });
      });
  }

  bindSettings();
  document.addEventListener("astro:page-load", bindSettings);
</script>
